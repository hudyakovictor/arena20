{
  "name": "@signal-arena/client",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "SIGNAL ARENA client — Phaser 4 game (WebGL canvas, rexUI, CandleChart, Zustand vanilla)",
  "scripts": {
    "predev": "node ../scripts/build-icons.mjs",
    "prebuild": "node ../scripts/build-icons.mjs",
    "dev": "vite --host 0.0.0.0 --port 5173",
    "build": "vite build",
    "preview": "vite preview --host 0.0.0.0 --port 4173",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@fontsource/inter": "^5.3.0",
    "@fontsource/jetbrains-mono": "^5.3.0",
    "@signal-arena/shared": "0.1.0",
    "phaser": "4.2.1",
    "phaser4-rex-plugins": "4.2.0",
    "zustand": "^5.0.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@types/node": "^26.5.0",
    "typescript": "^5.9.2",
    "vite": "^8.2.2",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "^5.0.0"
  }
}
